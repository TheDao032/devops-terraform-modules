---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${config.route.name}
  namespace: ${namespace}
spec:
  parentRefs:
    - name: traefik
      sectionName: http
      kind: Gateway

  rules:
     - matches:
        - path:
            type: PathPrefix
            value: ${config.route.path_prefix}

       backendRefs:
        - name: ${config.service.name}
          namespace: ${namespace}
          port: ${config.service.port}
