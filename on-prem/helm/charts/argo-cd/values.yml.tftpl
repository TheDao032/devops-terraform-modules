global:
  domain: ${parameters.values.baseref}

configs:
  params:
    server.insecure: true
    server.rootpath: ${parameters.values.rootpath}
  #   server.basehref: ${parameters.values.baseref}

  secret:
    argocdServerAdminPassword: ${parameters.values.admin_password}

server:
  ingress:
    enabled: false
    ingressClassName: "traefik"
    tls: false
