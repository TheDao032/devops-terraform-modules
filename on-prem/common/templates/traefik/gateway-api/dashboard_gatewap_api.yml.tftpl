---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${name}
  namespace: ${namespace}
spec:
  parentRefs:
    - name: ${gateway_class_name}
      sectionName: http
      kind: Gateway

  rules:
    - matches:
      - path:
          type: PathPrefix
          value: /dashboard
      - path:
          type: PathPrefix
          value: /api
    backendRefs:
      - name: traefik
        port: 9000
