---
# HTTPRoute — host/path routing into a backend Service via the shared Gateway.
# Rendered per entry in parameters.routing.httproutes by the routing module.
#
# Expected `route` object:
#   name, namespace, gateway_name, gateway_namespace, section_name,
#   hostnames (list), path_prefix, backend_name, backend_port
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${route.name}
  namespace: ${namespace}
spec:
  parentRefs:
    - kind: Gateway
      name: ${route.gateway_name}
      namespace: ${route.gateway_namespace}
      sectionName: ${route.section_name}
  hostnames:
%{ for h in route.hostnames ~}
    - "${h}"
%{ endfor ~}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: ${route.path_prefix}
      backendRefs:
        - kind: Service
          name: ${route.backend_name}
          port: ${route.backend_port}
