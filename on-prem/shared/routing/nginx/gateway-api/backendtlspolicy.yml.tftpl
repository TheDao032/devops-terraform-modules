---
# BackendTLSPolicy — same shape as the Traefik one (Gateway API is portable). NGINX Gateway
# Fabric supports caCertificateRefs to a ConfigMap OR a Secret, with the CA in key `ca.crt`
# (which cert-manager's tls Secret carries) — so this works with the same vault-tls-server
# Secret, no ConfigMap copy needed.
#
# Expected `policy` object: name, namespace, service_name, ca_secret_name, hostname
apiVersion: gateway.networking.k8s.io/v1
kind: BackendTLSPolicy
metadata:
  name: ${policy.name}
  namespace: ${namespace}
spec:
  targetRefs:
    - group: ""
      kind: Service
      name: ${policy.service_name}
  validation:
    caCertificateRefs:
      - group: ""
        kind: Secret
        name: ${policy.ca_secret_name}
    hostname: "${policy.hostname}"
