---
# HTTPRoute — identical to the Traefik one: Gateway API is controller-agnostic, so the
# route just references its Gateway by name/section (which controller backs that Gateway is
# decided by the Gateway's gatewayClassName, not here). This is the whole point of Gateway
# API — the same routes work under Traefik or NGINX Gateway Fabric.
#
# Expected `route` object:
#   name, namespace, gateway_name, gateway_namespace, section_name,
#   hostnames (list), path_prefix, backend_name, backend_port
#   request_headers (OPTIONAL map(string)) — headers to SET on every matching request
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${route.name}
  namespace: ${namespace}
spec:
  parentRefs:
    - kind: Gateway
      name: ${route.gateway_name}
      namespace: ${route.gateway_namespace}
      sectionName: ${route.section_name}
  hostnames:
%{ for h in route.hostnames ~}
    - "${h}"
%{ endfor ~}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: ${route.path_prefix}
%{ if try(length(route.request_headers), 0) > 0 ~}
      # RequestHeaderModifier — SET (not add) these on every request matching this route.
      #
      # This is a SECURITY control, not a convenience (IN-20). `set` overwrites whatever the client
      # sent, so a forged X-Forwarded-Host/Proto is discarded before it reaches the backend. That
      # matters because Traefik's forwardedHeaders.trustedIPs cannot be relied on here: k3s serves
      # type=LoadBalancer through klipper (svclb) pods, which SNAT every external packet into the
      # pod CIDR — so the "trust only in-cluster callers" rule actually trusts anyone who can reach
      # the LB IP. Verified 2026-08-23 by forging an issuer from outside the cluster.
      #
      # Because a value is pinned per route, a route carrying request_headers should list exactly
      # ONE hostname. Two hostnames sharing one pinned X-Forwarded-Host would make the second lie.
      filters:
        - type: RequestHeaderModifier
          requestHeaderModifier:
            set:
%{ for k, v in route.request_headers ~}
              - name: ${k}
                value: "${v}"
%{ endfor ~}
%{ endif ~}
      backendRefs:
        - kind: Service
          name: ${route.backend_name}
          port: ${route.backend_port}
