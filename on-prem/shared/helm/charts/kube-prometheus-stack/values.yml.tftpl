### kube-prometheus-stack — Prometheus + Grafana + Alertmanager + kube-state-metrics + node-exporter.
#
# ⚠️ FLAT STRING KEYS ONLY. The shared/helm module declares `variable "parameters"` as `map(any)`,
# and map(any) is NOT "anything" — Terraform unifies every element to ONE type. Nested objects of
# differing shapes (prometheus{strings + resources{}}, grafana{auth{},ingress{},resources{}},
# alertmanager{resources{}}) cannot unify and fail with:
#   "all map elements must have the same type"
# Every other chart here passes flat map(string) sub-maps for exactly this reason (see redis: master
# = {size="1Gi"}, auth = {password="..."}). Keep every value below a STRING; do not reintroduce
# nested blocks, and do not add a top-level scalar next to these maps (that breaks unification too).
#
# RESOURCE LIMITS ARE MANDATORY HERE, not hygiene. The FitMate lab schedules onto 3 agents with
# 3 vCPU / 3712Mi each (the single server is control-plane tainted). An unbounded Prometheus on
# such a node evicts whatever else lands there. Measured tuned footprint ≈ 1–1.8Gi.
# (Agents were 2 vCPU / 3072Mi until 2026-08-20, when k3s-server-2 was removed to fund the bump;
# guest disks went 40G -> 100G on 2026-08-25, which is what allows 30d retention.)
#
# Sizing rationale: this scrapes ~11 services plus kube components — a few thousand active series.
# That is small; the chart's own defaults are sized for production clusters and are 2–3x what is
# needed here.

### ── Prometheus ────────────────────────────────────────────────────────────────────────────────
prometheus:
  prometheusSpec:
    externalUrl: //${try(parameters.prometheus.ingress_prefix, "/")}

    # ⚠️ THE SETTING THAT DECIDES WHETHER ANYTHING IS SCRAPED AT ALL.
    # Default `true` makes Prometheus select ONLY ServiceMonitors carrying this Helm release's
    # labels. Every FitMate service chart renders a plain ServiceMonitor with no such label, so
    # with the default they are silently ignored: the CRD is accepted, the object exists, ArgoCD
    # is green, and Prometheus scrapes none of them. `false` selects ALL ServiceMonitors.
    # Same failure shape as SecretSynced-with-no-keys — verify targets are UP, never that the
    # ServiceMonitor object exists.
    serviceMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    probeSelectorNilUsesHelmValues: false
    # Watch every namespace (services live in fitmate-<svc>-<env>, not in the monitoring namespace).
    serviceMonitorNamespaceSelector: {}
    ruleNamespaceSelector: {}

    # Dev-lab retention. Short on purpose — a debugging aid, not a compliance store.
    # retentionSize is the hard stop that actually protects the node as series count grows.
    retention: ${try(parameters.prometheus.retention, "7d")}
    retentionSize: ${try(parameters.prometheus.retention_size, "4GB")}

    # ⚠️ WITHOUT THIS, PROMETHEUS RUNS ON emptyDir AND LOSES EVERY METRIC ON RESTART (IN-25).
    # The operator only creates a PVC when spec.storage is set; with it unset the pod silently
    # gets an emptyDir and nothing anywhere reports a problem.
    #
    # local-path DOES NOT ENFORCE `storage` — it bind-mounts a node directory, so this number is
    # documentation, not a quota. retentionSize above is the setting that actually bounds growth.
    # Raising one without the other is either a no-op (bigger PVC, same retentionSize) or a node
    # killer (bigger retentionSize, Prometheus eats the root fs until DiskPressure evicts
    # neighbours). MOVE BOTH TOGETHER. Official guidance: retentionSize <= 80-85% of this value,
    # the remainder being scratch for in-progress compactions.
    #
    # local-path also ships ALLOWVOLUMEEXPANSION: false, so this cannot be grown in place — resizing
    # means delete + recreate, destroying the history. Pick it once. On a real CSI (prod: Longhorn/
    # Ceph/cloud) expansion works and this constraint disappears.
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: ${try(parameters.prometheus.storage_class, "local-path")}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              # Default deliberately matches the DEFAULT retentionSize above (4GB / 0.8 = 5Gi),
              # so a caller who sets neither gets a coherent pair. FitMate overrides both.
              storage: ${try(parameters.prometheus.storage_size, "5Gi")}

    resources:
      requests:
        cpu: ${try(parameters.prometheus.cpu_request, "100m")}
        memory: ${try(parameters.prometheus.memory_request, "512Mi")}
      limits:
        cpu: ${try(parameters.prometheus.cpu_limit, "1000m")}
        memory: ${try(parameters.prometheus.memory_limit, "1Gi")}

    # Single replica: dev lab. HA Prometheus doubles the memory bill for no benefit here.
    replicas: 1

### ── Grafana ───────────────────────────────────────────────────────────────────────────────────
grafana:
  grafana.ini:
    server:
      root_url: "%(protocol)s://%(domain)s:%(http_port)s${try(parameters.grafana.ingress_prefix, "/")}"

  # Admin password from Vault (platform/grafana/creds) — NEVER the chart default `prom-operator`.
  # Grafana is exposed via HTTPRoute, so a default password is a cluster-wide credential sitting on
  # a routable hostname.
  adminPassword: ${parameters.grafana.password}

  # ⚠️ CPU LIMIT MUST BE GENEROUS — a tight one here does NOT protect the node, it just throttles
  # Grafana into a crash loop. First attempt used 300m and produced 5 restarts:
  #   grafana CPU sat at exactly 300m (pegged at the ceiling = CFS throttling)
  #   Liveness probe failed: dial tcp 10.42.x.x:3000: connect: connection refused
  #   Container grafana failed liveness probe, will be restarted
  #   lastState: reason=Error exit=1        <- NOT OOMKilled(137); memory was never the issue
  # Grafana 13.x registers ~10 `*.grafana.app` API groups at boot and is genuinely CPU-hungry for
  # the first ~2 minutes, then idles near 0. Throttled, it never opened :3000 before liveness gave up.
  #
  # Only REQUESTS are reserved by the scheduler; limits cost no capacity. So a high CPU limit with a
  # low request is free headroom for a bursty startup. Tight limits are a memory discipline, not a
  # CPU one — that distinction is what the first attempt got wrong.
  resources:
    requests:
      cpu: ${try(parameters.grafana.cpu_request, "100m")}
      memory: ${try(parameters.grafana.memory_request, "192Mi")}
    limits:
      cpu: ${try(parameters.grafana.cpu_limit, "1000m")}
      memory: ${try(parameters.grafana.memory_limit, "384Mi")}

  # Liveness must not police STARTUP. Without a startupProbe the chart's livenessProbe begins after
  # initialDelaySeconds=60 and kills a container that is still booting — which is exactly what
  # happened. A startupProbe suspends liveness until it succeeds, giving boot a 300s budget
  # (30 x 10s) while keeping liveness tight afterwards for a genuinely wedged process.
  # Verified the subchart honours this key by rendering chart 88.5.2 with it set.
  startupProbe:
    httpGet:
      path: /api/health
      port: 3000
    periodSeconds: 10
    failureThreshold: 30

%{ if try(parameters.grafana.storage_size, "") != "" ~}
  # Grafana state that is NOT reproducible from code: annotations (incident markers), users and
  # their preferences, starred dashboards, Explore history, and the alert-rule state Grafana owns.
  # Dashboards themselves come from the sidecar as ConfigMaps and datasources are provisioned, so
  # this is deliberately small — it is not where dashboards live.
  # Omit grafana.storage_size entirely to run stateless (the previous behaviour).
  # NOTE for prod: prefer an EXTERNAL database (the existing Postgres/Citus) over a PVC — that is
  # what unlocks more than one Grafana replica. A ReadWriteOnce PVC pins Grafana to one node and
  # caps it at a single replica.
  persistence:
    enabled: true
    type: pvc
    storageClassName: ${try(parameters.grafana.storage_class, "local-path")}
    accessModes: ["ReadWriteOnce"]
    size: ${parameters.grafana.storage_size}
%{ endif ~}

%{ if try(parameters.grafana.loki_url, "") != "" ~}
  # Loki datasource — only rendered when the env actually supplies grafana.loki_url. FitMate has no
  # Loki deployed; emitting this unconditionally would point Grafana at nothing.
  # NOTE: nested UNDER grafana (not a top-level `loki_url`) so `parameters` stays a uniform
  # map-of-maps — a top-level scalar would break map(any) unification.
  additionalDataSources:
    - name: Loki
      access: proxy
      isDefault: false
      jsonData:
        httpHeaderName1: X-Scope-OrgID
      secureJsonData:
        httpHeaderValue1: 1
      orgId: 1
      type: loki
      url: http://${parameters.grafana.loki_url}:3100
%{ endif ~}

### ── Alertmanager ──────────────────────────────────────────────────────────────────────────────
# Rules evaluate from day one; DELIVERY (Telegram/Slack/etc.) is wired LAST, deliberately. An
# unrouted alert still fires and still shows in the UI, which is what proves the rule works before
# a notification channel is chosen.
alertmanager:
  alertmanagerSpec:
    replicas: 1
    resources:
      requests:
        cpu: ${try(parameters.alertmanager.cpu_request, "20m")}
        memory: ${try(parameters.alertmanager.memory_request, "64Mi")}
      limits:
        cpu: ${try(parameters.alertmanager.cpu_limit, "150m")}
        memory: ${try(parameters.alertmanager.memory_limit, "128Mi")}

### ── Exporters + operator ──────────────────────────────────────────────────────────────────────
kube-state-metrics:
  resources:
    requests: { cpu: 20m, memory: 64Mi }
    limits: { cpu: 150m, memory: 128Mi }

prometheus-node-exporter:
  resources:
    requests: { cpu: 10m, memory: 24Mi }
    limits: { cpu: 100m, memory: 48Mi }

prometheusOperator:
  resources:
    requests: { cpu: 20m, memory: 64Mi }
    limits: { cpu: 200m, memory: 128Mi }

### ── Components deliberately disabled on this lab ──────────────────────────────────────────────
# k3s runs these inside the server process and does not expose the standard scrape endpoints, so
# the default ServiceMonitors would sit permanently DOWN and generate noise indistinguishable from
# a real outage. Turned off so that a red target means something.
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeProxy:
  enabled: false
kubeEtcd:
  enabled: false
