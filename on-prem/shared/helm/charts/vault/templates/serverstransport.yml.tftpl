# Traefik ServersTransport for the Vault backend leg.
#
# The ingress re-encrypts: browser --TLS--> Traefik --TLS--> Vault (serversscheme: https).
# On that second leg Traefik is a TLS *client* and validates Vault's server cert. Vault's
# leaf is signed by the cert-manager PRIVATE CA, which is NOT in Traefik's default trust
# store, so verification fails and the route returns 500. This ServersTransport is the
# per-backend TLS client config that tells Traefik how to handle that connection.
#
# Referenced from the Vault ingress via the annotation:
#   traefik.ingress.kubernetes.io/service.serverstransport: "$${namespace}-backend@kubernetescrd"
# (Ingress reference format is "<namespace>-<name>@kubernetescrd".)
#
# API GROUP: `traefik.io/v1alpha1`, honored by the SELF-MANAGED Traefik v3 (its Helm chart
# ships the traefik.io CRDs in crds/, and the kubernetesCRD provider is enabled). This is why
# Vault stays on an Ingress instead of Gateway API: the Traefik-CRD ServersTransport path works
# here — unlike the k3s-bundled Traefik (broken CRD bundle) and unlike the Gateway API
# BackendTLSPolicy (can't verify the backend, traefik/traefik#12127).
apiVersion: traefik.io/v1alpha1
kind: ServersTransport
metadata:
  name: backend
  namespace: ${namespace}
spec:
  # Lab-grade: accept Vault's self-signed backend cert. The hop is Traefik->Vault entirely
  # inside the cluster pod network.
  #
  # TO SWITCH TO *VERIFIED* backend TLS (works on self-managed v3 — `serverName` IS honored
  # here, which defeats the pod-IP verification wall that broke the Gateway API path): replace
  # the `insecureSkipVerify` line below with —
  #   rootCAsSecrets:
  #     - $${parameters.common.vault_tls_server_name}   # cert-manager tls secret (holds ca.crt)
  #   serverName: $${parameters.common.host}            # vault.k3s.local — a SAN on Vault's cert
  insecureSkipVerify: true
