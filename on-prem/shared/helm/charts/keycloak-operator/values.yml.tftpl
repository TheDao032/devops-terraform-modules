# The Keycloak instance (the "main" resource of this manifest-mode chart — applied by shared/helm's
# kubectl_manifest.main since helm_release_enabled = false). Requires: the CRDs (installed cluster-once
# by init-resources), the operator running (templates/pre-exec/), and the DB Secret (templates/exec/).
# Rendered by the generic shared/helm module with its namespace + parameters context.
apiVersion: k8s.keycloak.org/v2beta1
kind: Keycloak
metadata:
  name: keycloak
  namespace: ${namespace}
spec:
  instances: ${parameters.keycloak.instances}
  # Bootstrap admin from a Secret we control (keycloak/admin/creds via Vault) instead of the
  # operator's auto-generated temp-admin. NOTE: only consumed on the FIRST bootstrap of a fresh DB —
  # an already-bootstrapped Keycloak keeps its existing admin until the keycloak DB is reset.
  bootstrapAdmin:
    user:
      secret: keycloak-admin
%{ if try(parameters.keycloak.image, "") != "" ~}
  # CUSTOM IMAGE. Setting this changes the SERVER for every realm on it (fitmate-dev, -stg and
  # prod all live on this one instance) — only `login_theme`, set per realm by the shared/keycloak
  # module, is tenant-scoped. bosch and renesas are unaffected: they run a different module
  # entirely (on-prem/helm/charts/keycloak), not this operator.
  #
  # THE OPERATOR STARTS A CUSTOM IMAGE WITH --optimized. Per the CRD's own `startOptimized`
  # description, "if left unspecified the operator will assume custom images have already been
  # augmented". That skips the boot-time build step the stock image currently relies on here:
  # the live pod today starts with plain `start` and re-augments every boot (its
  # lib/quarkus/ artifacts are rewritten at each start), consuming the KC_DB / KC_HEALTH_ENABLED
  # env the operator injects.
  #
  # MEASURED 2026-08-26 on keycloak 26.7.0: an image built WITHOUT those baked in refuses them at
  # an --optimized start with
  #   "The following build time options have values that differ from what is persisted - the new
  #    values will NOT be used until another build is run: kc.health-enabled, kc.db"
  # health-enabled ignored means no /health/* on :9000 — and the operator wires ALL THREE probes
  # (startup, readiness, liveness) there, so the pod never goes Ready and the StatefulSet rollout
  # hangs while the container log looks clean. db ignored means no postgres driver.
  # => the image referenced here MUST bake `ENV KC_DB=postgres` and `ENV KC_HEALTH_ENABLED=true`
  #    before its `kc.sh build`. Re-verify this list if the operator's injected env ever changes.
  image: ${parameters.keycloak.image}
%{ endif ~}
%{ if try(parameters.keycloak.image_pull_secret, "") != "" ~}
  # Only needed when the image lives in a PRIVATE registry. The named Secret must already exist in
  # this namespace — nothing here creates it. Leave unset for a public package and the kubelet
  # pulls anonymously; set it and forget the Secret, and you get ImagePullBackOff.
  imagePullSecrets:
    - name: ${parameters.keycloak.image_pull_secret}
%{ endif ~}
%{ if length(try(parameters.keycloak.additional_options, {})) > 0 ~}
  # Free-form server options, rendered in sorted key order (Terraform iterates maps lexically, so
  # this list is stable and does not churn the plan).
  #
  # RUNTIME OPTIONS ONLY. With a custom image the server starts --optimized, and any BUILD-TIME
  # option placed here is silently ignored — the Keycloak operator guide says so outright ("with
  # custom images, every build time option passed either through a dedicated field or the
  # additionalOptions is ignored"). Build-time options belong in the image's Dockerfile.
  #
  # For SPI options the build-time set is exactly those whose names end in `--provider`,
  # `--enabled` or `--provider-default`; everything else is runtime. The theme cache options used
  # here end in none of those, so they are runtime and correct to set from the CR.
  #
  # Names carry NO leading dashes here — the operator turns each into an env var
  # (spi-theme--cache-themes -> KC_SPI_THEME__CACHE_THEMES) and Keycloak maps it back, preserving
  # the double separator. Values are quoted because the CRD types them as strings.
  additionalOptions:
%{ for k, v in try(parameters.keycloak.additional_options, {}) ~}
    - name: ${k}
      value: "${v}"
%{ endfor ~}
%{ endif ~}
  # Override the operator's PROD default (requests 1700Mi / limit 2Gi) — too big for the 2Gi-node
  # lab (no single node has 1700Mi free → FailedScheduling). Keycloak 26 is Quarkus, so it's happy
  # in ~1Gi. Env-overridable via parameters.keycloak.resources.{requests_cpu,requests_memory,limits_memory}.
  resources:
    requests:
      cpu: ${try(parameters.keycloak.resources.requests_cpu, "500m")}
      memory: ${try(parameters.keycloak.resources.requests_memory, "768Mi")}
    limits:
      memory: ${try(parameters.keycloak.resources.limits_memory, "1Gi")}
  db:
    vendor: postgres
    host: ${parameters.db.host}
    port: ${parameters.db.port}
    database: ${parameters.db.database}
    usernameSecret:
      name: keycloak-db
      key: username
    passwordSecret:
      name: keycloak-db
      key: password
  # ── Frontend hostname — decides the `iss` claim on every token this server issues (IN-15) ──────
  #
  # PINNED (hostname_dynamic = false, the DEFAULT): Keycloak uses this exact host for all frontend
  # URLs, so every realm stamps `iss = <scheme>://<hostname>/realms/<realm>` regardless of how the
  # request arrived. One Keycloak serving three envs therefore issues ONE issuer for all of them —
  # which is why the prod overlays' expected issuer (https://auth.fitmate.me/realms/fitmate) does
  # not match reality, as recorded in fitmate-gitops apps/trainee-service/prod/values.yaml:55-58.
  #
  # DYNAMIC (hostname_dynamic = true): omit `hostname` and set `strict: false`. Per the CRD,
  # `strict` "disables dynamically resolving the hostname from request headers" — so FALSE turns
  # dynamic resolution ON. Keycloak then derives the frontend URL (and `iss`) from the incoming
  # request, which with `proxy.headers: xforwarded` below means X-Forwarded-Host. One server then
  # serves many hosts, each stamping its own correct issuer:
  #     auth.dev.fitmate.me  -> iss https://auth.dev.fitmate.me/realms/fitmate-dev
  #     auth.fitmate.me      -> iss https://auth.fitmate.me/realms/fitmate
  #     keycloak.k3s.fitmate -> iss http://keycloak.k3s.fitmate/realms/<realm>   (unchanged)
  #
  # ⚠️ BACKWARDS COMPATIBLE: switching to dynamic does NOT change `iss` for requests that keep
  # arriving on the current host — the derived value is identical. It only ADDS the ability for
  # other hosts to issue their own. So this can be enabled BEFORE any issuer cutover, and verified
  # independently, rather than as one big-bang change.
  #
  # ⚠️ SECURITY: dynamic resolution trusts the proxy. Keycloak will believe whatever Host /
  # X-Forwarded-Host it is handed, so a token's `iss` becomes attacker-influenced if arbitrary
  # hosts can reach it (host-header injection). This is only safe because Traefik routes by
  # Gateway API HTTPRoute `hostnames` — an unlisted Host does not route at all. Adding a hostname
  # to that route is therefore a security decision, not just a routing one. Do NOT enable dynamic
  # resolution behind a proxy that forwards unmatched hosts.
  hostname:
%{ if try(parameters.keycloak.hostname_dynamic, false) ~}
    strict: false
%{ else ~}
    hostname: ${parameters.keycloak.hostname}
%{ endif ~}
  # Gateway (Traefik) terminates TLS and forwards HTTP → Keycloak serves plain HTTP and trusts the
  # X-Forwarded-* headers. The operator's own Ingress is disabled; we route via Gateway API HTTPRoute.
  http:
    httpEnabled: true
  proxy:
    headers: xforwarded
  ingress:
    enabled: false
