# Bootstrap admin credentials for the Keycloak master realm (referenced by the CR's
# spec.bootstrapAdmin.user.secret). Values come from Vault (keycloak/admin/creds) via ops-tools
# parameters.admin.{username,password}. A Keycloak USER — separate from the keycloak-db DB role.
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: keycloak-admin
  namespace: ${namespace}
stringData:
  username: ${parameters.admin.username}
  password: ${parameters.admin.password}
