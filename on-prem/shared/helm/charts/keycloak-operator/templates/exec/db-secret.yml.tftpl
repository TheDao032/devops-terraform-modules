# DB credentials Secret the Keycloak CR references (usernameSecret/passwordSecret). Values come from
# Vault via the terragrunt vault-secrets dependency → ops-tools parameters.db.{username,password}.
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: keycloak-db
  namespace: ${namespace}
stringData:
  username: ${parameters.db.username}
  password: ${parameters.db.password}
