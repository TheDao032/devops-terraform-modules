# Traefik v3 (chart 41.0.2 / app v3.7.6) — self-managed ingress+gateway controller.
#
# Replaces the k3s-BUNDLED Traefik v2.11 (disabled via `--disable=traefik` in the lab's
# config.yaml) so we control the version and get Gateway API for services deployed later.
# CRD sources: Traefik's OWN traefik.io CRDs (IngressRoute/Middleware/ServersTransport) ship
# in this chart's crds/ dir; the Gateway API standard CRDs come from module "gateway-api-crds"
# (shared/crds), which this release depends_on. NOTE: Vault routes via its Ingress +
# ServersTransport, NOT Gateway API (BackendTLSPolicy can't verify its backend, #12127).

deployment:
  kind: Deployment
  replicas: 1            # lab; raise for HA (needs podAntiAffinity + a real LB)

# ── Providers ────────────────────────────────────────────────────────────────
providers:
  # The Gateway API provider — powers Gateway / HTTPRoute / BackendTLSPolicy.
  kubernetesGateway:
    enabled: true
  # Traefik IngressRoute/Middleware CRD provider — kept (dashboard + any CRD routes).
  kubernetesCRD:
    enabled: true
  # Plain Ingress provider — Vault routes through this (its Helm-chart Ingress).
  kubernetesIngress:
    enabled: true

# ── Backend TLS ──────────────────────────────────────────────────────────────
# Skip verification of backend server certs on the DEFAULT ServersTransport.
#
# PRIMARY mechanism for Vault is its OWN per-backend ServersTransport (charts/vault
# templates/serverstransport.yml.tftpl, `insecureSkipVerify: true`, referenced by the Vault
# Ingress annotation) — self-managed v3 HONORS it (unlike the broken k3s-bundled Traefik).
# This global flag is a SAFETY NET: if that per-backend transport isn't applied for any
# reason, Vault falls back to the default transport, which this covers. Lab-grade — it also
# means any FUTURE HTTPS backend without its own ServersTransport skips verify by default;
# for prod, drop this and verify per-backend (serverName + rootCAsSecrets).
additionalArguments:
  - "--serversTransport.insecureSkipVerify=true"

# ── Default Gateway + GatewayClass ───────────────────────────────────────────
# The chart deploys a default GatewayClass ("traefik") and a default Gateway when the
# Gateway provider is on. Open the web listener to Routes from ALL namespaces — the Vault
# HTTPRoute lives in the `vault` namespace, not Traefik's, and the Gateway-API default is
# same-namespace only. (namespacePolicy maps to the listener's allowedRoutes.namespaces.)
gatewayClass:
  enabled: true
gateway:
  enabled: true
  name: traefik-gateway    # stable name so HTTPRoute parentRefs don't chase the release name
  listeners:
    web:
      port: 8000
      protocol: HTTP
      namespacePolicy:
        from: All

# ── Service (edge) ───────────────────────────────────────────────────────────
# LoadBalancer → Klipper (servicelb) assigns the node IPs, exactly like the bundled one.
service:
  type: LoadBalancer

# ── Entrypoints / exposed ports ──────────────────────────────────────────────
ports:
  web:
    port: 8000
    exposedPort: 80
    expose:
      default: true
  websecure:
    port: 8443
    exposedPort: 443
    expose:
      default: true

# ── Dashboard / API ──────────────────────────────────────────────────────────
# Dashboard served internally (api@internal) and exposed via the CHART's built-in IngressRoute
# (this replaces the old routing-module dashboard.yml.tftpl — exactly ONE owner now). The host
# defaults to the env-derived pattern (env=local → traefik.k3s.local; map it in /etc/hosts) UNLESS
# the caller passes `parameters.dashboard_host`. FitMate sets it to `traefik.k3s.fitmate` so the
# dashboard matches the cluster suffix keycloak/vault/argocd already use (this chart's env = "shared").
api:
  dashboard: true
ingressRoute:
  dashboard:
    enabled: true
    matchRule: Host(`${try(parameters.dashboard_host, "traefik.k3s.${environment}")}`)
    entryPoints:
      - web
