# Traefik v3 (chart 41.0.2 / app v3.7.6) — self-managed ingress+gateway controller.
#
# Replaces the k3s-BUNDLED Traefik v2.11 (disabled via `--disable=traefik` in the lab's
# config.yaml) so we control the version and get full Gateway API support, incl.
# BackendTLSPolicy (re-encrypt to private-CA TLS backends like the cert-manager-issued
# Vault). Traefik's own CRDs + the Gateway API CRDs are installed by the separate
# traefik-crds release (charts/traefik-crds), which this release depends on.

deployment:
  kind: Deployment
  replicas: 1            # lab; raise for HA (needs podAntiAffinity + a real LB)

# ── Providers ────────────────────────────────────────────────────────────────
providers:
  # The Gateway API provider — powers Gateway / HTTPRoute / BackendTLSPolicy.
  kubernetesGateway:
    enabled: true
  # Traefik IngressRoute/Middleware CRD provider — kept (dashboard + any CRD routes).
  kubernetesCRD:
    enabled: true
  # Plain Ingress provider — kept during migration so any not-yet-migrated Ingress
  # (e.g. Vault's, until we flip it to an HTTPRoute) still routes. Drop once migrated.
  kubernetesIngress:
    enabled: true

# ── Default Gateway + GatewayClass ───────────────────────────────────────────
# The chart deploys a default GatewayClass ("traefik") and a default Gateway when the
# Gateway provider is on. Open the web listener to Routes from ALL namespaces — the Vault
# HTTPRoute lives in the `vault` namespace, not Traefik's, and the Gateway-API default is
# same-namespace only. (namespacePolicy maps to the listener's allowedRoutes.namespaces.)
gatewayClass:
  enabled: true
gateway:
  enabled: true
  name: traefik-gateway    # stable name so HTTPRoute parentRefs don't chase the release name
  listeners:
    web:
      port: 8000
      protocol: HTTP
      namespacePolicy:
        from: All

# ── Service (edge) ───────────────────────────────────────────────────────────
# LoadBalancer → Klipper (servicelb) assigns the node IPs, exactly like the bundled one.
service:
  type: LoadBalancer

# ── Entrypoints / exposed ports ──────────────────────────────────────────────
ports:
  web:
    port: 8000
    exposedPort: 80
    expose:
      default: true
  websecure:
    port: 8443
    exposedPort: 443
    expose:
      default: true

# ── Dashboard / API ──────────────────────────────────────────────────────────
# Dashboard served internally on the 'traefik' entrypoint. We expose it via Gateway API
# in the router layer (follow-up), NOT via the insecure IngressRoute, so leave that off.
api:
  dashboard: true
ingressRoute:
  dashboard:
    enabled: false
