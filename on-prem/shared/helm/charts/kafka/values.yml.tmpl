#  heapOpts: -Xmx1024m -Xms1024m
#  persistence:
#    enabled: true
#    storageClass: ${parameters.common.sc_name}
#    mountPath: ${parameters.broker.mount_path}
#    size: ${parameters.broker.size}
#  autoscaling:
#    hpa:
#      enabled: ${parameters.broker.hpa_active}
#      minReplicas: ${parameters.broker.min_replicas}
#      maxReplicas: ${parameters.broker.max_replicas}

externalAccess:
  autoDiscovery:
    enabled: true
  enabled: true
  controller:
    service:
      type: LoadBalancer

serviceAccount:
  create: true

rbac:
  create: true

metrics:
  jmx:
    enabled: true

kraft:
  enabled: true
  clusterId: kraft_cluster

zookeeper:
  enabled: false
