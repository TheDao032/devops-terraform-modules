apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ${parameters.secret.argocd_secret_name}
  namespace: ${namespace}
spec:
  refreshInterval: "1h"  # Sync interval
  secretStoreRef:
    name: ${parameters.secret.store_name}  # Reference to SecretStore
    kind: SecretStore
  target:
    name: ${parameters.secret.argocd_secret_name}  # Kubernetes Secret name
    creationPolicy: Owner  # Creates the secret if it does not exist
  dataFrom:
    - extract:
        key: platform/argocd/creds  # platform-tier prefix — secrets are seeded at fitmate/data/platform/* (NOT per-env; environment here = "shared")
