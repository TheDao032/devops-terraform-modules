---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ${parameters.secret.docker_config_secret_name}
  namespace: ${namespace}
spec:
  refreshInterval: "1m"
  secretStoreRef:
    name: ${parameters.secret.store_name}  # Reference to your SecretStore
    kind: SecretStore
  target:
    name: ${parameters.secret.docker_config_secret_name}
    creationPolicy: Owner
    template:
      type: kubernetes.io/dockerconfigjson
      data:
        .dockerconfigjson: |
          {
            "auths": {
              "{{ .registry }}": {
                "username": "{{ .username }}",
                "password": "{{ .password }}",
                "email": "{{ .email }}",
                "auth": ""
              }
            }
          }
  dataFrom:
    - extract:
        key: platform/docker/creds  # Path in Vault — platform-tier prefix (seeded at fitmate/data/platform/*)
    - extract:
        key: platform/docker/params  # Path in Vault — platform-tier prefix
