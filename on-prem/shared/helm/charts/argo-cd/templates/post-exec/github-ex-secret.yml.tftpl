---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ${parameters.secret.github_secret_name}
  namespace: ${namespace}
spec:
  refreshInterval: "1m"
  secretStoreRef:
    name: ${parameters.secret.store_name}  # Reference to your Vault SecretStore
    kind: SecretStore
  target:
    name: ${parameters.secret.github_secret_name}
    creationPolicy: Owner
    template:
      type: Opaque
      metadata:
        labels:
          argocd.argoproj.io/secret-type: repo-creds
      data:
        # HTTPS PAT auth — the fitmate-gitops repo is HTTPS (url = https://github.com/FITMate-Platform),
        # so this repo-creds template MUST carry username+password, NOT an sshPrivateKey. A prior
        # sshPrivateKey here (leftover from the retired git@github.com SSH deploy-key repo) matched the
        # HTTPS repo by URL prefix and made ArgoCD attempt SSH over HTTPS → "failed to list refs:
        # invalid auth method". username + token both come from the ${environment}/github/creds extract.
        url: "{{ .url }}"
        username: "{{ .username }}"
        password: "{{ .token }}"
  dataFrom:
    - extract:
        key: ${environment}/github/params  # Path in Vault
    - extract:
        key: ${environment}/github/creds  # Path in Vault
