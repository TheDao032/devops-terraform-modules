apiVersion: external-secrets.io/v1
kind: SecretStore
metadata:
  name: ${parameters.secret.store_name}
  namespace: ${namespace}
spec:
  provider:
    vault:
      server: ${parameters.secret.vault_address}
      path: ${parameters.secret.kv_mount}   # org KV mount = "fitmate" (was the env "local" — the WRONG mount, caused ESO 403s)
      version: "v2"
      auth:
        appRole:
          path: ${parameters.secret.approle_path}     # "approle"
          roleId: ${parameters.secret.role_id}        # cleartext — it's not secret
          secretRef:
            name: ${parameters.secret.approle_secret_name}
            key: secretId
