global:
  domain: ${parameters.ingress.domain}

configs:
  cm:
    admin.enabled: true
    # How often ArgoCD polls git + re-reconciles EVERY Application (chart/ArgoCD default = 180s).
    # 30s = near-real-time sync for this lab. NOTE: for INSTANT sync, prefer a GitHub webhook
    # (POST /api/webhook) over aggressive polling — a short interval re-lists all resources for
    # every app each tick (heavier as app count grows). Takes effect on the next argo-cd apply.
    timeout.reconciliation: 30s
    # external-secrets' CRD defaults three fields into every ExternalSecret at admission
    # (conversionStrategy/decodingStrategy/metadataPolicy on each remoteRef + extract). The gitops
    # charts don't set them, so ArgoCD sees live≠git and pins every ExternalSecret to OutOfSync
    # forever (Healthy, but noisy — re-applying git can't strip a server-defaulted field). Ignore
    # those defaulted paths fleet-wide so ExternalSecrets report Synced. Real spec changes still diff.
    resource.customizations.ignoreDifferences.external-secrets.io_ExternalSecret: |
      jqPathExpressions:
        - '.spec.data[]?.remoteRef.conversionStrategy'
        - '.spec.data[]?.remoteRef.decodingStrategy'
        - '.spec.data[]?.remoteRef.metadataPolicy'
        - '.spec.dataFrom[]?.extract.conversionStrategy'
        - '.spec.dataFrom[]?.extract.decodingStrategy'
        - '.spec.dataFrom[]?.extract.metadataPolicy'
  params:
    server.insecure: true
  # HTTPS credential for the private fitmate-gitops repo (FITMate-Platform org). Matched by URL prefix
  # to the repositories entry below. username + PAT come from Vault github/creds. (Was an SSH deploy-key
  # credentialTemplate for the retired git@github.com:TheDao032/gitops-apps repo.)
  credentialTemplates:
    https-creds:
      url: ${parameters.github.url}
      username: ${parameters.github.username}
      password: ${parameters.github.token}
  repositories:
    fitmate-gitops:
      url: ${parameters.github.url}/${parameters.github.gitops_repo}
      name: fitmate-gitops
      type: git
      project: default
    # OCI Helm credential for the PRIVATE per-service charts on GHCR (ghcr.io/fitmate-platform,
    # ADR-037). The child Applications' first source is `repoURL: ghcr.io/fitmate-platform` +
    # `chart: fitmate-<svc>` — pulling it needs an OCI-enabled helm repo cred, SEPARATE from the git
    # cred above. Without this, `helm pull oci://ghcr.io/...` gets HTTP 401 unauthorized (the package
    # is private). Same github PAT (it already carries read:packages); prod should later swap to a
    # dedicated read:packages-only token. enableOCI + type helm are what mark this as an OCI registry.
    fitmate-ghcr-charts:
      url: ghcr.io/fitmate-platform
      name: fitmate-ghcr-charts
      type: helm
      enableOCI: "true"
      username: ${parameters.github.username}
      password: ${parameters.github.token}

  secret:
    # This chart field wants a BCRYPT HASH, not plaintext. The hash is pre-computed (stably) in the
    # vault-secrets module via random_password.bcrypt_hash and delivered here as admin_password
    # (ops-tools reads argocd/creds.password_bcrypt). DO NOT call bcrypt() here — it's
    # non-deterministic and templatefile() rejects it ("function returned an inconsistent result").
    argocdServerAdminPassword: ${parameters.common.admin_password}

server:
  # UI/API is exposed via a Gateway API HTTPRoute (module "argocd-routing" in addons.tf) on the
  # shared traefik-gateway `web` listener — consistent with the "new HTTP services use Gateway
  # API" rule. The chart's built-in Ingress is therefore OFF. server.insecure=true (configs.params
  # above) makes argocd-server serve plain HTTP on :80, so the HTTPRoute backendRef needs no
  # backend TLS (this is why ArgoCD avoids Vault's #12127 BackendTLSPolicy problem).
  ingress:
    enabled: false
