### kube-prometheus-stack — Prometheus + Grafana + Alertmanager + kube-state-metrics + node-exporter.
#
# RESOURCE LIMITS ARE MANDATORY HERE, not hygiene. The FitMate lab schedules onto 3 agents with
# 2 vCPU / 2962Mi each (both servers are control-plane tainted), ~51% already used. An unbounded
# Prometheus on a 2.9Gi node evicts whatever else lands there. Every component below therefore
# carries explicit requests AND limits. Measured tuned footprint ≈ 1–1.8Gi total.
#
# Sizing rationale: this scrapes ~11 services plus kube components — a few thousand active series.
# That is small. The defaults shipped by kube-prometheus-stack are sized for production clusters
# and are 2–3x what is needed here.

### ── Prometheus ────────────────────────────────────────────────────────────────────────────────
prometheus:
  prometheusSpec:
    externalUrl: //${parameters.prometheus.ingress.prefix}

    # ⚠️ THE SETTING THAT DECIDES WHETHER ANYTHING IS SCRAPED AT ALL.
    # Default `true` makes Prometheus select ONLY ServiceMonitors carrying this Helm release's
    # labels. Every FitMate service chart renders a plain ServiceMonitor with no such label, so
    # with the default they are silently ignored: the CRD is accepted, the object exists, ArgoCD
    # is green, and Prometheus scrapes none of them. Setting false selects ALL ServiceMonitors.
    # This is the same failure shape as SecretSynced-with-no-keys — always verify by checking that
    # targets are UP, never by checking that the ServiceMonitor exists.
    serviceMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    probeSelectorNilUsesHelmValues: false
    # Watch every namespace (services live in fitmate-<svc>-<env>, not in the monitoring namespace).
    serviceMonitorNamespaceSelector: {}
    ruleNamespaceSelector: {}

    # Dev lab retention. Short on purpose — this is a debugging aid, not a compliance store.
    # retentionSize is the hard stop that actually protects the node when series count grows.
    retention: ${try(parameters.prometheus.retention, "7d")}
    retentionSize: ${try(parameters.prometheus.retention_size, "4GB")}

    resources:
      requests:
        cpu: ${try(parameters.prometheus.resources.requests.cpu, "100m")}
        memory: ${try(parameters.prometheus.resources.requests.memory, "512Mi")}
      limits:
        cpu: ${try(parameters.prometheus.resources.limits.cpu, "1000m")}
        memory: ${try(parameters.prometheus.resources.limits.memory, "1Gi")}

    # Single replica: this is a dev lab. HA Prometheus doubles the memory bill for no benefit here.
    replicas: 1

### ── Grafana ───────────────────────────────────────────────────────────────────────────────────
grafana:
  grafana.ini:
    server:
      root_url: "%(protocol)s://%(domain)s:%(http_port)s${parameters.grafana.ingress.prefix}"

  # Admin password comes from Vault (platform/grafana/creds) via the env's vault-secrets output —
  # NEVER the chart default `prom-operator`. Exposed via HTTPRoute, so a default password is a
  # cluster-wide credential sitting on a routable hostname.
  adminPassword: ${parameters.grafana.auth.password}

  resources:
    requests:
      cpu: ${try(parameters.grafana.resources.requests.cpu, "50m")}
      memory: ${try(parameters.grafana.resources.requests.memory, "128Mi")}
    limits:
      cpu: ${try(parameters.grafana.resources.limits.cpu, "300m")}
      memory: ${try(parameters.grafana.resources.limits.memory, "256Mi")}

%{ if try(parameters.loki_url, "") != "" ~}
  # Loki datasource — only rendered when the env actually supplies loki_url. FitMate has no Loki
  # deployed; emitting this unconditionally would give Grafana a datasource pointing at nothing.
  additionalDataSources:
    - name: Loki
      access: proxy
      isDefault: false
      jsonData:
        httpHeaderName1: X-Scope-OrgID
      secureJsonData:
        httpHeaderValue1: 1
      orgId: 1
      type: loki
      url: http://${parameters.loki_url}:3100
%{ endif ~}

### ── Alertmanager ──────────────────────────────────────────────────────────────────────────────
# Rules are defined and evaluated from day one; DELIVERY (Telegram/Slack/etc.) is wired LAST,
# deliberately. An unrouted alert still shows in the UI and still proves the rule fires — which is
# what we want to validate before choosing a notification channel.
alertmanager:
  alertmanagerSpec:
    replicas: 1
    resources:
      requests:
        cpu: ${try(parameters.alertmanager.resources.requests.cpu, "20m")}
        memory: ${try(parameters.alertmanager.resources.requests.memory, "64Mi")}
      limits:
        cpu: ${try(parameters.alertmanager.resources.limits.cpu, "150m")}
        memory: ${try(parameters.alertmanager.resources.limits.memory, "128Mi")}

### ── Exporters + operator ──────────────────────────────────────────────────────────────────────
kube-state-metrics:
  resources:
    requests: { cpu: 20m, memory: 64Mi }
    limits:   { cpu: 150m, memory: 128Mi }

prometheus-node-exporter:
  resources:
    requests: { cpu: 10m, memory: 24Mi }
    limits:   { cpu: 100m, memory: 48Mi }

prometheusOperator:
  resources:
    requests: { cpu: 20m, memory: 64Mi }
    limits:   { cpu: 200m, memory: 128Mi }

### ── Components deliberately disabled on this lab ──────────────────────────────────────────────
# k3s runs these as part of the server process and does not expose the standard scrape endpoints,
# so the default ServiceMonitors would sit permanently DOWN and generate noise indistinguishable
# from a real outage. Turned off so a red target means something.
kubeControllerManager:
  enabled: ${try(parameters.kube_components_enabled, false)}
kubeScheduler:
  enabled: ${try(parameters.kube_components_enabled, false)}
kubeProxy:
  enabled: ${try(parameters.kube_components_enabled, false)}
kubeEtcd:
  enabled: ${try(parameters.kube_components_enabled, false)}
