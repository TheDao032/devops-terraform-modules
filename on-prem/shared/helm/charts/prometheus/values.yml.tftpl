grafana:
  grafana.ini:
      server:
        root_url: "%(protocol)s://%(domain)s:%(http_port)s${parameters.grafana.ingress.prefix}"
  adminPassword: ${parameters.grafana.auth.password}
  additionalDataSources:
    - name: Loki
      access: proxy
      isDefault: false
      jsonData:
        httpHeaderName1: X-Scope-OrgID
      secureJsonData:
        httpHeaderValue1: 1
      orgId: 1
      type: loki
      url: http://${parameters.loki_url}:3100

prometheus:
  prometheusSpec:
    externalUrl: //${parameters.prometheus.ingress.prefix}
