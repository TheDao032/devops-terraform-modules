loki:
  auth_enabled: ${parameters.common_conf.loki.auth_enabled}
  schemaConfig:
    configs:
      - from: "2024-04-01"
        store: tsdb
        object_store: filesystem
        schema: v13
        index:
          prefix: loki_index_
          period: 24h
  ingester:
    chunk_encoding: snappy
  querier:
    # Default is 4, if you have enough memory and CPU you can increase, reduce if OOMing
    max_concurrent: ${parameters.loki_conf.querier.max_concurrent} # 1
  pattern_ingester:
    enabled: true
  limits_config:
    allow_structured_metadata: true
    volume_enabled: true
    retention_period: 336h
    reject_old_samples: false
    reject_old_samples_max_age: 43800h
    ingestion_rate_mb: 8
    ingestion_burst_size_mb: 8

deploymentMode: Distributed

ingester:
  replicas: ${parameters.loki_conf.ingester.replicas} # To ensure data durability with replication
  zoneAwareReplication:
     enabled: false

querier:
  replicas: ${parameters.loki_conf.querier.replicas}
  maxUnavailable: ${parameters.loki_conf.querier.max_unavailable}
queryFrontend:
  replicas: ${parameters.loki_conf.query_frontend.replicas}
  maxUnavailable: ${parameters.loki_conf.query_frontend.max_unavailable}
queryScheduler:
  replicas: ${parameters.loki_conf.query_scheduler.replicas}
distributor:
  replicas: ${parameters.loki_conf.distributor.replicas}
  maxUnavailable: ${parameters.loki_conf.distributor.max_unavailable}
compactor:
  replicas: ${parameters.loki_conf.compactor.replicas}
indexGateway:
  replicas: ${parameters.loki_conf.index_gateway.replicas}
  maxUnavailable: ${parameters.loki_conf.index_gateway.max_unavailable}

bloomPlanner:
  replicas: ${parameters.loki_conf.bloom_planner.replicas}
bloomBuilder:
  replicas: ${parameters.loki_conf.bloom_builder.replicas}
bloomGateway:
  replicas: ${parameters.loki_conf.bloom_gateway.replicas}

singleBinary:
   replicas: ${parameters.loki_conf.single_binary.replicas}

backend:
  replicas: ${parameters.loki_conf.backend.replicas}
  persistence:
    storageClass: ${parameters.storage_class}
read:
  replicas: ${parameters.loki_conf.read.replicas}
  persistence:
    storageClass: ${parameters.storage_class}
write: # To ensure data durability with replication
  replicas: ${parameters.loki_conf.write.replicas}
  persistence:
    storageClass: ${parameters.storage_class}

# Enable minio for storage
minio:
  enabled: true
  persistence:
    storageClass: ${parameters.storage_class}

gateway:
  basicAuth:
    enabled: ${parameters.auth_conf.is_enabled}
    username: ${parameters.auth_conf.username}
    password: ${parameters.auth_conf.password}

memcached:
  resources:
    requests:
      memory: ${parameters.loki_conf.memcached.rq_mem}
      cpu: ${parameters.loki_conf.memcached.rq_cpu}
    limits:
      memory: ${parameters.loki_conf.memcached.limits_mem}
      cpu: ${parameters.loki_conf.memcached.limits_cpu}

memcachedExporter:
  resources:
    requests:
      memory: ${parameters.loki_conf.memcached_exporter.rq_mem}
      cpu: ${parameters.loki_conf.memcached_exporter.rq_cpu}
    limits:
      memory: ${parameters.loki_conf.memcached_exporter.limits_mem}
      cpu: ${parameters.loki_conf.memcached_exporter.limits_cpu}
