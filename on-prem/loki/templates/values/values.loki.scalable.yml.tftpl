  loki:
    schemaConfig:
      configs:
        - from: "2024-04-01"
          store: tsdb
          object_store: s3
          schema: v13
          index:
            prefix: loki_index_
            period: 24h
    ingester:
      chunk_encoding: snappy
    querier:
      # Default is 4, if you have enough memory and CPU you can increase, reduce if OOMing
      max_concurrent: ${loki_conf.querier.max_concurrent}
    pattern_ingester:
      enabled: true
    limits_config:
      allow_structured_metadata: true
      volume_enabled: true

  deploymentMode: SimpleScalable

backend:
  replicas: ${loki_conf.backend.replicas}
  persistence:
    storageClass: ${storage_class}
read:
  replicas: ${loki_conf.read.replicas}
  persistence:
    storageClass: ${storage_class}
write: # To ensure data durability with replication
  replicas: ${loki_conf.write.replicas}
  persistence:
    storageClass: ${storage_class}


  # Enable minio for storage
  minio:
    enabled: true

  gateway:
    service:
      type: LoadBalancer

memcached:
  resources:
    requests:
      memory: ${loki_conf.memcached.rq_mem}
      cpu: ${loki_conf.memcached.rq_cpu}
    limits:
      memory: ${loki_conf.memcached.limits_mem}
      cpu: ${loki_conf.memcached.limits_cpu}

memcachedExporter:
  resources:
    requests:
      memory: ${loki_conf.memcached_exporter.rq_mem}
      cpu: ${loki_conf.memcached_exporter.rq_cpu}
    limits:
      memory: ${loki_conf.memcached_exporter.limits_mem}
      cpu: ${loki_conf.memcached_exporter.limits_cpu}
